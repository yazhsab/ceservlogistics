# Courier OS — environment template.
#
# Copy to .env and fill in real values. NEVER commit a filled-in .env: it is in
# .gitignore for that reason. Every variable below is parsed and validated at
# startup; an invalid value fails the process immediately rather than at first
# use (see internal/platform/config).

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
SERVICE_NAME=courier-os
SERVICE_VERSION=dev
# GIT_COMMIT and BUILT_AT are injected by the Docker build; leave unset locally.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=1048576         # 1 MiB for JSON requests
HTTP_MAX_UPLOAD_BYTES=26214400      # 25 MiB for bulk-import CSV uploads

# Comma-separated full origins. '*' is refused in staging and production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# Only requests arriving from these peers may set X-Forwarded-For. Rate limiting
# and login throttling key on the resolved client IP, so trusting the header
# from an arbitrary peer would be a trivial bypass. Set this to your Nginx or
# load balancer address, never to 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Must be false in staging and production; the config layer enforces it.
ENABLE_DEBUG_ROUTES=true
ENABLE_METRICS=true
METRICS_ADDR=127.0.0.1:9090         # keep bound to loopback; scrape via the host

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://courier:courier@localhost:5432/courier_os?sslmode=disable
# Pool sizing for 4 vCPU / 16 GB (Constitution §28). Two API replicas at 20 plus
# one worker at 8 is 48 server-side connections against max_connections=100,
# leaving headroom for migrations, psql and backups.
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=55m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_STATEMENT_TIMEOUT=15s      # a runaway query cannot pin a pool slot
DATABASE_HEALTHCHECK_PERIOD=30s

# ---------------------------------------------------------------------------
# Redis / Valkey
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=16
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s
REDIS_KEY_PREFIX=cos:
# When false the API starts even if Redis is down and degrades to always-miss.
# Defaults to true in staging and production.
REDIS_REQUIRED=false

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=courier-os
ACCESS_TOKEN_TTL=15m                # short-lived bearer token
REFRESH_TOKEN_TTL=720h              # 30 days, rotated on every use
SESSION_CACHE_TTL=30s               # bounds how stale a revocation check can be
PASSWORD_RESET_TTL=30m
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_DURATION=15m
LOGIN_THROTTLE_WINDOW=1m
LOGIN_THROTTLE_MAX=10

# Argon2id cost. The defaults target ~50-70 ms per hash on the production box.
# Raise ARGON2_MEMORY_KIB before ARGON2_TIME when hardening; every hash records
# the cost it was created with, so existing credentials keep verifying.
ARGON2_TIME=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=2
ARGON2_KEY_LENGTH=32

# Optional first-run bootstrap of the platform operator. Set both or neither,
# and unset them once the account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORG_CODE=PLATFORM
BOOTSTRAP_ORG_NAME=Platform Operator

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true             # must be true in staging and production
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=120
# Partner API keys get their own budget, per key rather than per address: a
# partner behind one NAT must not be throttled by another partner's traffic.
PARTNER_RATE_LIMIT_PER_MINUTE=300

# The worker's own health and metrics listener. Its jobs metrics are recorded
# in this process, so nothing scrapes them without it.
WORKER_HEALTH_ADDR=0.0.0.0:8090

# The customer-facing tracking page. Used in notifications; a wrong value sends
# customers somewhere that is not yours.
PUBLIC_TRACKING_URL=https://track.example.com
HSTS_ENABLED=false                  # defaults to true in staging and production
HSTS_MAX_AGE=4320h

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=2s
WORKER_BATCH_SIZE=10
WORKER_QUEUES=default,import
WORKER_SHUTDOWN_TIMEOUT=30s
WORKER_JOB_MAX_ATTEMPTS=5
WORKER_STUCK_JOB_TIMEOUT=15m

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=0.05      # keep sampling low on the 4 vCPU target

LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # json | text

# ---------------------------------------------------------------------------
# Booking policy
# ---------------------------------------------------------------------------
# --- Home market -------------------------------------------------------------
# What a tenant becomes when it does not state its own. Nigeria is first; the
# platform stays multi-market and an organization may override every one.
DEFAULT_COUNTRY=NG
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos

AWB_PREFIX_DEFAULT=CSV              # 2-4 uppercase letters; per-tenant override
MAX_PACKAGES_PER_SHIPMENT=50
QUOTE_CACHE_TTL=60s
ROUTING_CACHE_TTL=5m
ROUTING_EXPLANATION_TTL=1h
BOOKING_BACKDATE_HOURS=0

# ---------------------------------------------------------------------------
# Object storage — POD photos, signatures, labels, exports (Release 2)
# ---------------------------------------------------------------------------
# `filesystem` is for local development only. The application refuses to start
# with it when APP_ENV=production: containers run read-only, and proof of
# delivery written to a container layer is lost on the next deploy.
STORAGE_DRIVER=filesystem           # s3 | filesystem — must be s3 in production
STORAGE_DIR=./tmp/objects           # filesystem driver only
STORAGE_ENDPOINT=                   # required for s3, e.g. https://s3.eu-central-003.backblazeb2.com
STORAGE_BUCKET=courier-os
STORAGE_ACCESS_KEY=                 # required for s3
STORAGE_SECRET_KEY=                 # required for s3
STORAGE_REGION=us-east-1
STORAGE_USE_PATH_STYLE=true         # true for MinIO/Backblaze-style endpoints
STORAGE_MAX_OBJECT_BYTES=8388608    # 8 MiB; accepted range 1 KiB - 64 MiB
STORAGE_SIGNED_URL_TTL=15m

# --- Notification providers (M26) --------------------------------------------
# A channel left unconfigured keeps its logging sender, which records what it
# would have sent. Check GET /api/v1/notifications/channels to see which
# channels are actually live — an unconfigured channel suppresses every message
# on it, and that is the most common cause of "notifications are not working".
#
# Termii serves SMS and WhatsApp for Nigeria from one account.
TERMII_API_KEY=                     # empty leaves every channel on the log sender
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=                   # the alphanumeric header registered with the NCC
TERMII_SMS_CHANNEL=dnd              # dnd | generic — dnd reaches subscribers who blocked promos
TERMII_ENABLE_SMS=true
TERMII_WHATSAPP_FROM=               # registered WhatsApp number; empty disables the channel
